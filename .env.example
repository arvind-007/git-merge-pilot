# git-merge-pilot environment. Run `pnpm init-env` to create .env with generated secrets.
# Everything else (GitHub App credentials, AI keys, SMTP, Slack) is configured in the UI
# and stored encrypted in the database.

# Postgres connection (docker-compose.dev.yml exposes port 54329)
DATABASE_URL=postgres://gmp:gmp@localhost:54329/gmp

# Public base URL used for GitHub webhooks and OAuth/manifest callbacks
PUBLIC_URL=http://localhost:3000

# Optional: where users open the web UI when it is not PUBLIC_URL. `pnpm dev` defaults it to
# the Vite dev server (http://localhost:5173, see apps/server/dev.env). Leave unset otherwise.
# WEB_URL=

PORT=3000

# base64-encoded 32 random bytes. Encrypts all stored credentials. BACK IT UP.
MASTER_KEY=

# base64-encoded >= 32 random bytes
SESSION_SECRET=

GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Optional webhook relay for local development (https://smee.io/new)
SMEE_URL=

# Optional: choose the one-time setup token yourself (16+ chars). When set, it is never printed.
# GMP_SETUP_TOKEN=

REPO_CACHE_DIR=./.data/repos
LOG_LEVEL=info
NODE_ENV=development

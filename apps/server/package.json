    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.11",
    "@gmp/ai": "workspace:*",
    "@gmp/analysis": "workspace:*",
    "@gmp/core": "workspace:*",
    "@gmp/db": "workspace:*",
    "@gmp/github": "workspace:*",
    "@gmp/notify": "workspace:*",
    "@gmp/worker": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "pg-boss": "^12.38.2",
    "smee-client": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "nock": "^15.0.6"
  }
